p:\/\/localhost:8000\/assets\/images\/PosterMaq1.avif\"\n              data-mp4=\"http:\/\/localhost:8000\/assets\/videos\/Maquette1mini.mp4\"\n              data-hevc=\"http:\/\/localhost:8000\/assets\/videos\/Maquette1mini_hevc.mp4\"\n              data-vp9=\"http:\/\/localhost:8000\/assets\/videos\/Maquette1mini_vp9.webm\"\n            >\n              <span class=\"tab-label\">Essentiel<\/span>\n            <\/button>\n          <\/div>\n\n          <!-- Standard -->\n          <div class=\"mac-tab-wrap\">\n            <button\n              class=\"mac-tab tab-standard px-3 py-1.5 text-xs sm:text-sm rounded-md font-semibold whitespace-nowrap\"\n              data-plan=\"Standard\"\n              data-tagline=\"L\u2019\u00e9quilibre parfait : design + fonctionnalit\u00e9s.\"\n              data-poster=\"http:\/\/localhost:8000\/assets\/images\/PosterMaq2.avif\"\n              data-mp4=\"http:\/\/localhost:8000\/assets\/videos\/Maquette2mini.mp4\"\n              data-hevc=\"http:\/\/localhost:8000\/assets\/videos\/Maquette2mini_hevc.mp4\"\n              data-vp9=\"http:\/\/localhost:8000\/assets\/videos\/Maquette2mini_vp9.webm\"\n            >\n              <span class=\"tab-label\">Standard<\/span>\n            <\/button>\n          <\/div>\n\n          <!-- Premium -->\n          <div class=\"mac-tab-wrap\">\n            <button\n              class=\"mac-tab tab-premium px-3 py-1.5 text-xs sm:text-sm rounded-md font-semibold whitespace-nowrap\"\n              data-plan=\"Premium\"\n              data-tagline=\"Le haut de gamme, qui refl\u00e8te votre identit\u00e9.\"\n              data-poster=\"http:\/\/localhost:8000\/assets\/images\/PosterMaq3.avif\"\n              data-mp4=\"http:\/\/localhost:8000\/assets\/videos\/Maquette3mini.mp4\"\n              data-hevc=\"http:\/\/localhost:8000\/assets\/videos\/Maquette3mini_hevc.mp4\"\n              data-vp9=\"http:\/\/localhost:8000\/assets\/videos\/Maquette3mini_vp9.webm\"\n            >\n              <span class=\"tab-label\">Premium<\/span>\n            <\/button>\n          <\/div>\n\n        <\/div>\n      <\/div>\n\n      <!-- CONTENU -->\n      <div class=\"p-6 text-gray-200 text-sm sm:text-base\">\n\n        <div class=\"portfolio-heading mb-8\">\n          <h2>\n            Besoin d\u2019inspiration ?<br>\n            D\u00e9couvrez nos <span>maquettes<\/span>.\n          <\/h2>\n          <h4>Quelques exemples pour visualiser diff\u00e9rents styles et comparer nos gammes de sites.<\/h4>\n        <\/div>\n\n        <!-- VIDEO MULTI-FORMATS -->\n        <div class=\"portfolio-stage\">\n          <video\n            id=\"portfolioVideo\"\n            class=\"portfolio-video\"\n            muted\n            playsinline\n            loop\n            preload=\"none\"\n            poster=\"http:\/\/localhost:8000\/assets\/images\/PosterMaq1.avif\"\n            decoding=\"async\"\n          >\n            <!-- VP9 prioritaire -->\n            <source src=\"http:\/\/localhost:8000\/assets\/videos\/Maquette1mini_vp9.webm\" type=\"video\/webm\">\n\n            <!-- HEVC pour Safari\/iOS -->\n            <source src=\"http:\/\/localhost:8000\/assets\/videos\/Maquette1mini_hevc.mp4\" type=\"video\/mp4; codecs=hev1\">\n\n            <!-- H.264 fallback -->\n            <source src=\"http:\/\/localhost:8000\/assets\/videos\/Maquette1mini.mp4\" type=\"video\/mp4\">\n          <\/video>\n\n          <div class=\"portfolio-caption\">\n            <span class=\"badge badge-essentiel\">Essentiel<\/span>\n            <p class=\"tagline\">L\u2019essentiel pour d\u00e9marrer vite et bien.<\/p>\n          <\/div>\n        <\/div>\n\n        <!-- Voir plus -->\n        <div class=\"more-mockups\">\n          <button id=\"moreMockupsBtn\"\n            class=\"btn-secondary more-btn\"\n            type=\"button\"\n            aria-expanded=\"false\"\n            aria-controls=\"moreMockupsPanel\"\n          >\n            <span class=\"more-btn-label\">Voir d\u2019autres maquettes<\/span>\n            <span class=\"more-btn-icon\">\u25be<\/span>\n          <\/button>\n\n          <div id=\"moreMockupsPanel\" class=\"more-panel\" hidden>\n            <p class=\"more-intro\">Des variations visuelles pour vous inspirer.<\/p>\n\n            <div class=\"more-grid\">\n                              <figure class=\"more-card\">\n                  <img\n                    src=\"http:\/\/localhost:8000\/assets\/images\/mockups\/maq1.avif\"\n                    alt=\"Maquette 1\"\n                    loading=\"lazy\"\n                    decoding=\"async\"\n                  >\n                <\/figure>\n                              <figure class=\"more-card\">\n                  <img\n                    src=\"http:\/\/localhost:8000\/assets\/images\/mockups\/maq2.avif\"\n                    alt=\"Maquette 2\"\n                    loading=\"lazy\"\n                    decoding=\"async\"\n                  >\n                <\/figure>\n                              <figure class=\"more-card\">\n                  <img\n                    src=\"http:\/\/localhost:8000\/assets\/images\/mockups\/maq3.avif\"\n                    alt=\"Maquette 3\"\n                    loading=\"lazy\"\n                    decoding=\"async\"\n                  >\n                <\/figure>\n                              <figure class=\"more-card\">\n                  <img\n                    src=\"http:\/\/localhost:8000\/assets\/images\/mockups\/maq4.avif\"\n                    alt=\"Maquette 4\"\n                    loading=\"lazy\"\n                    decoding=\"async\"\n                  >\n                <\/figure>\n                              <figure class=\"more-card\">\n                  <img\n                    src=\"http:\/\/localhost:8000\/assets\/images\/mockups\/maq5.avif\"\n                    alt=\"Maquette 5\"\n                    loading=\"lazy\"\n                    decoding=\"async\"\n                  >\n                <\/figure>\n                  