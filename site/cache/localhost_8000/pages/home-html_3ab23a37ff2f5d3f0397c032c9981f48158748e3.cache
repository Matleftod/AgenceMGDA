\"Glow\"\n          >\n\n          <!-- Pot -->\n          <img \n            loading=\"lazy\" \n            src=\"\" \n            data-src=\"http:\/\/localhost:8000\/assets\/images\/plante\/pot.avif\" \n            class=\"plante-pot plante-layer\" \n            alt=\"Pot\"\n          >\n\n          <!-- FEUILLE 1 -->\n          <div class=\"feuille-wrapper f1-wrapper\" data-leaf=\"1\">\n            <svg class=\"feuille-hitbox f1-hitbox\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 2974 3482\">\n              <path class=\"hitbox-path\"\n                d=\"M1512,1566l13-175,42-228,46-149,307-76,177-196,81-252,16-197-5-243L1934,182,1767,295,1607,490l-90,255,81,252-59,158-28,109-36,206Z\"\n                fill=\"rgba(255,255,255,0.001)\" \/>\n            <\/svg>\n            <img \n              loading=\"lazy\" \n              src=\"\" \n              data-src=\"http:\/\/localhost:8000\/assets\/images\/plante\/feuille1.avif\" \n              class=\"feuille-img f1-img animA plante-layer\" \n              alt=\"Feuille 1\"\n            >\n          <\/div>\n\n          <!-- FEUILLE 2 -->\n          <div class=\"feuille-wrapper f2-wrapper\" data-leaf=\"2\">\n            <svg class=\"feuille-hitbox f2-hitbox\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"\n              viewBox=\"0 0 2974 3482\">\n              <path class=\"hitbox-path\"\n                d=\"M1556,1778l-29-152-47-142-58-120-92-139-14-155-40-126-83-124-90-95L918,579,713,501,463,446l95,246,82,166,29,54,76,93,86,81,130,86,94,34,105,23,120,19,23-1,30,41,48,84,28,55,27,67,22,81,23,104,11,110,4,216,13-54,14-63,14-55Z\"\n                fill=\"rgba(255,255,255,0.001)\" \/>\n            <\/svg>\n            <img \n              loading=\"lazy\" \n              src=\"\" \n              data-src=\"http:\/\/localhost:8000\/assets\/images\/plante\/feuille2.avif\" \n              class=\"feuille-img f2-img animB plante-layer\" \n              alt=\"Feuille 2\"\n            >\n          <\/div>\n\n          <!-- FEUILLE 3 -->\n          <div class=\"feuille-wrapper f3-wrapper\" data-leaf=\"3\">\n            <svg class=\"feuille-hitbox f3-hitbox\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"\n              viewBox=\"0 0 2974 3482\">\n              <path class=\"hitbox-path\"\n                d=\"M1560,1998l-14,23-19,48-11,37-7-44-14-39,20-104,23-87,18-57,34-90,31-73,36-70,21-36,1-28,28-123,30-79,20-38,73-64,137-85,37-18,103-32,168-13,162,10,138,19,77,22-87,110-57,72-138,140-46,37-77,50-80,44-49,22-105,20-106,3-85-7-93-23-29-8-8,9-13,24-27,64-27,70-17,56-20,74-17,81Z\"\n                fill=\"rgba(255,255,255,0.001)\" \/>\n            <\/svg>\n            <img \n              loading=\"lazy\" \n              src=\"\" \n              data-src=\"http:\/\/localhost:8000\/assets\/images\/plante\/feuille3.avif\" \n              class=\"feuille-img f3-img animA plante-layer\" \n              alt=\"Feuille 3\"\n            >\n          <\/div>\n\n          <!-- FEUILLE 4 -->\n          <div class=\"feuille-wrapper f4-wrapper\" data-leaf=\"4\">\n            <svg class=\"feuille-hitbox f4-hitbox\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"\n              viewBox=\"0 0 2974 3482\">\n              <path class=\"hitbox-path\"\n                d=\"M1516,2105l-6,16-7,29-43-6-7-68-19-96-30-84-29-62-35-56-104,43-83,26h-45l-81-15-82-22-57-30-106-53-133-64L383,1561l-3-3,25-23,64-40,91-41,118-37,38-9,22-5,112-4,133,12,76,14,53,16,47,18,59,30,44,30,36,39,27,47,20,52,12,46,8,40,1,20,11,18,33,47,33,61,23,56,21,63,6,16Z\"\n                fill=\"rgba(255,255,255,0.001)\" \/>\n            <\/svg>\n            <img \n              loading=\"lazy\" \n              src=\"\" \n              data-src=\"http:\/\/localhost:8000\/assets\/images\/plante\/feuille4.avif\" \n              class=\"feuille-img f4-img animB plante-layer\" \n              alt=\"Feuille 4\"\n            >\n          <\/div>\n\n          <!-- FEUILLE 5 -->\n          <div class=\"feuille-wrapper f5-wrapper\" data-leaf=\"5\">\n            <svg class=\"feuille-hitbox f5-hitbox\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"\n              viewBox=\"0 0 2974 3482\">\n              <path class=\"hitbox-path\"\n                d=\"M1570,2171l-67-21,10-37,13-41,21-54,15-20,70-94,60-42,74-47,109-47,75-17,90-7,46,3,57,11,57,18,56,30,55,43,63,66,36,45,43,68,50,98,19,54-332-28-68-6-140-25-53-16-77-43-60-50-39-52-46-75-13,1-18,16-16,20-32,51-22,47-18,50-10,44Z\"\n                fill=\"rgba(255,255,255,0.001)\" \/>\n            <\/svg>\n            <img \n              loading=\"lazy\" \n              src=\"\" \n              data-src=\"http:\/\/localhost:8000\/assets\/images\/plante\/feuille5.avif\" \n              class=\"feuille-img f5-img animC plante-layer\" \n              alt=\"Feuille 5\"\n            >\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <!-- COLONNE DROITE : CARTES -->\n      <div class=\"about-right\">\n\n          <div class=\"eco-cards\">\n\n            <div class=\"eco-entry\" data-leaf=\"1\">\n                <div class=\"eco-header\">\n                <span class=\"eco-icon\">\ud83d\udccd<\/span>\n                <h3>Agence Web \u00e0 B\u00e8gles<\/h3>\n                <span class=\"eco-chevron\">\u276f<\/span>\n                <\/div>\n                <div class=\"eco-content\">\n                <p>Agence web install\u00e9e \u00e0 B\u00e8gles, nous concevons des sites \u00e0 la fois esth\u00e9tiques, performants et responsables.\nNotre priorit\u00e9 : offrir des solutions durables, bien pens\u00e9es, et adapt\u00e9es aux besoins de chaque entreprise.<\/p>\n                <\/div>\n            <\/div>\n\n            <div class=\"eco-entry\" data-leaf=\"2\">\n                <div class=\"eco-header\">\n                <span class=\"eco-icon\">\ud83d\ude80<\/span>\n                <h3>Kirby CMS<\/h3>\n                <span class=\"eco-chevron\">\u276f<\/span>\n                <\/div>\n                <div class=\"eco-content\">\n                <p>Nous utilisons Kirby, un CMS ultra-l\u00e9ger et flexible, sans base de donn\u00e9es.\nR\u00e9sultat : un site plus rapide, plus s\u00e9curis\u00e9, plus \u00e9cologique et incroyablement simple \u00e0 maintenir.<\/p>\n                <\/div>\n            <\/div>\n\n            <div class=\"eco-entry\" data-leaf=\"3\">\n                <div class=\"eco-header\">\n                <span class=\"eco-icon\">\ud83c\udf31<\/span>\n                <h3>Certification INR<\/h3>\n                <span class=\"eco-chevron\">\u276f<\/span>\n                <\/div>\n                <div class=\"eco-content\">\n                <p>L\u2019agence est engag\u00e9e dans une d\u00e9marche de sobri\u00e9t\u00e9 num\u00e9rique et d\u00e9tient la certification INR.\nChaque projet est pens\u00e9 pour r\u00e9duire son impact, sans sacrifier les performances ou l\u2019exp\u00e9rience utilisateur.<\/p>\n                <\/div>\n            <\/div>\n\n            <div class=\"eco-entry\" data-leaf=\"4\">\n                <div class=\"eco-header\">\n                <span class=\"eco-icon\">\ud83e\udd1d<\/span>\n                <h3>Accompagnement \u00e0 taille humaine<\/h3>\n                <span class=\"eco-chevron\">\u276f<\/span>\n                <\/div>\n                <div class=\"eco-content\">\n                <p>Nous mettons un vrai point d\u2019honneur \u00e0 accompagner chaque client avec attention et clart\u00e9.\nNotre d\u00e9marche est simple : \u00e9couter, comprendre, et construire un projet qui te ressemble vraiment, sans complexit\u00e9 inutile.<\/p>\n                <\/div>\n            <\/div>\n\n            <div class=\"eco-entry\" data-leaf=\"5\">\n                <div class=\"eco-header\">\n                <span class=\"eco-icon\">\ud83d\udee0\ufe0f<\/span>\n                <h3>Site cl\u00e9 en main<\/h3>\n                <span class=\"eco-chevron\">\u276f<\/span>\n                <\/div>\n                <div class=\"eco-content\">\n                <p>Chaque site est livr\u00e9 avec un espace d\u2019\u00e9dition tr\u00e8s facile \u00e0 utiliser.\nTu peux mettre \u00e0 jour ton contenu quand tu veux, en toute autonomie, sans passer par un d\u00e9veloppeur.<\/p>\n                <\/div>\n            <\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n  \n  <div class=\"relative\">\n  <div class=\"bg-glow-2\"><\/div>\n  <section id=\"services\" class=\"services\" aria-labelledby=\"services-title\">\n  <h2 id=\"services-title\" class=\"invisible\">Nos services<\/h2>\n  <div class=\"services-container\">\n\n    <div class=\"services-heading\">\n      <h2>\n        Ce Que Nous <span>Cr\u00e9ons<\/span>\n      <\/h2>\n      <h4>\n        Des solutions digitales durables, performantes et con\u00e7ues avec soin.\n      <\/h4>\n    <\/div>\n\n    <div class=\"services-grid\">\n\n      <!-- 1 \u2014 \u00c9volutivit\u00e9 -->\n      <div class=\"service-card\" data-service=\"1\">\n        <div class=\"service-tag\">\u00c9volutif<\/div>\n\n        <div class=\"service-header\">\n          <span class=\"service-icon\">\n            <!-- settings -->\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-settings w-6 h-6\"><path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z\"><\/path><circle cx=\"12\" cy=\"12\" r=\"3\"><\/circle><\/svg>\n          <\/span>\n          <h3>Site Web \u00e9volutif<\/h3>\n        <\/div>\n\n        <p class=\"service-desc\">\n          Ton site peut \u00e9voluer au fil du temps.\n        <\/p>\n        <div class=\"service-more\">\n          <p>\n            Nous cr\u00e9ons des bases techniques durables, capables de grandir avec ton activit\u00e9.\n            L\u2019objectif : un site qui reste pertinent longtemps.\n          <\/p>\n        <\/div>\n        <div class=\"service-toggle\">Voir plus<\/div>\n      <\/div>\n\n      <!-- 2 \u2014 Responsive -->\n      <div class=\"service-card\" data-service=\"2\">\n        <div class=\"service-tag\">Mobile<\/div>\n\n        <div class=\"service-header\">\n          <span class=\"service-icon\">\n            <!-- zap -->\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-zap w-6 h-6\"><path d=\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"><\/path><\/svg>\n          <\/span>\n          <h3>Site 100% responsive<\/h3>\n        <\/div>\n\n        <p class=\"service-desc\">\n          Une exp\u00e9rience parfaite sur mobile, tablette et ordinateur.\n        <\/p>\n        <div class=\"service-more\">\n          <p>\n            Ton site s\u2019adapte naturellement \u00e0 tous les \u00e9crans sans compromis sur la lisibilit\u00e9 ou la performance.\n          <\/p>\n        <\/div>\n        <div class=\"service-toggle\">Voir plus<\/div>\n      <\/div>\n\n      <!-- 3 \u2014 Design -->\n      <div class=\"service-card\" data-service=\"3\">\n        <div class=\"service-tag\">Design<\/div>\n\n        <div class=\"service-header\">\n          <span class=\"service-icon\">\n            <!-- palette -->\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-palette w-6 h-6\"><circle cx=\"13.5\" cy=\"6.5\" r=\".5\" fill=\"currentColor\"><\/circle><circle cx=\"17.5\" cy=\"10.5\" r=\".5\" fill=\"currentColor\"><\/circle><circle cx=\"8.5\" cy=\"7.5\" r=\".5\" fill=\"currentColor\"><\/circle><circle cx=\"6.5\" cy=\"12.5\" r=\".5\" fill=\"currentColor\"><\/circle><path d=\"M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z\"><\/path><\/svg>\n          <\/span>\n          <h3>Design moderne & performance<\/h3>\n        <\/div>\n\n        <p class=\"service-desc\">\n          Un site esth\u00e9tique, lisible et ultra-rapide.\n        <\/p>\n        <div class=\"service-more\">\n          <p>\n            Nous soignons chaque d\u00e9tail visuel et optimisons les performances : fluidit\u00e9, confort, harmonie.\n          <\/p>\n        <\/div>\n        <div class=\"service-toggle\">Voir plus<\/div>\n      <\/div>\n\n      <!-- 4 \u2014 Formation -->\n      <div class=\"service-card\" data-service=\"4\">\n        <div class=\"service-tag\">Formation<\/div>\n\n        <div class=\"service-header\">\n          <span class=\"service-icon\">\n            <!-- leaf -->\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-leaf w-6 h-6\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"><\/path><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"><\/path><\/svg>\n          <\/span>\n          <h3>Formation \u00e0 la gestion du site<\/h3>\n        <\/div>\n\n        <p class=\"service-desc\">Une prise en main claire et personnalis\u00e9e.<\/p>\n        <div class=\"service-more\">\n          <p>\n            Apr\u00e8s la mise en ligne, tu re\u00e7ois un guide simple et adapt\u00e9 \u00e0 ton site pour apprendre \u00e0 modifier tes pages, g\u00e9rer ton contenu et rester autonome.\n          <\/p>\n        <\/div>\n        <div class=\"service-toggle\">Voir plus<\/div>\n      <\/div>\n\n      <!-- 5 \u2014 H\u00e9bergement -->\n      <div class=\"service-card\" data-service=\"5\">\n        <div class=\"service-tag\">H\u00e9bergement<\/div>\n\n        <div class=\"service-header\">\n          <span class=\"service-icon\">\n            <!-- server -->\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-server w-6 h-6\"><rect width=\"20\" height=\"8\" x=\"2\" y=\"2\" rx=\"2\" ry=\"2\"><\/rect><rect width=\"20\" height=\"8\" x=\"2\" y=\"14\" rx=\"2\" ry=\"2\"><\/rect><line x1=\"6\" x2=\"6.01\" y1=\"6\" y2=\"6\"><\/line><line x1=\"6\" x2=\"6.01\" y1=\"18\" y2=\"18\"><\/line><\/svg>\n          <\/span>\n          <h3>H\u00e9bergement du site<\/h3>\n        <\/div>\n\n        <p class=\"service-desc\">On s\u2019occupe de tout.<\/p>\n        <div class=\"service-more\">\n          <p>\n            Nous prenons en charge la mise en place de l\u2019h\u00e9bergement et la configuration de ton site sur un serveur fiable et performant.\n          <\/p>\n        <\/div>\n        <div class=\"service-toggle\">Voir plus<\/div>\n      <\/div>\n\n      <!-- 6 \u2014 Modules -->\n      <div class=\"service-card\" data-service=\"6\">\n        <div class=\"service-tag\">Modules<\/div>\n\n        <div class=\"service-header\">\n          <span class=\"service-icon\">\n            <!-- settings again -->\n            <svg fill=\"currentColor\" version=\"1.1\" id=\"Capa_1\"\n                  xmlns=\"http:\/\/www.w3.org\/2000\/svg\"\n                  xmlns:xlink=\"