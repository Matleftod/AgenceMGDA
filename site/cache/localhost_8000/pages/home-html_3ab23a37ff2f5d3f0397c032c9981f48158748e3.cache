{"created":1765571414,"minutes":0,"value":{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"description\" content=\"Agence MGDA : Nous cr\u00e9ons des sites vitrines \u00e9cologiques et sur-mesure, pens\u00e9s pour les commer\u00e7ants, artisans, cr\u00e9atifs et entreprises \u00e0 taille humaine. Des sites beaux, simples \u00e0 g\u00e9rer au quotidien, et con\u00e7us pour valoriser pleinement votre savoir-faire.\">\n    <meta name=\"robots\" content=\"index, follow\">\n\n    <!-- Favicon principal -->\n    <link rel=\"icon\" href=\"\/favicon.ico\" type=\"image\/x-icon\">\n    <link rel=\"icon\" href=\"\/favicon.svg\" type=\"image\/svg+xml\">\n    \n    <!-- Favicon PNG (pour Chrome & autres navigateurs modernes) -->\n    <link rel=\"icon\" type=\"image\/png\" sizes=\"32x32\" href=\"\/favicon-32x32.png\">\n    <link rel=\"icon\" type=\"image\/png\" sizes=\"96x96\" href=\"\/favicon-96x96.png\">\n\n    <!-- Ic\u00f4ne Apple (iOS et macOS) -->\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"\/apple-touch-icon.png\">\n\n    <!-- Ic\u00f4nes pour Android et PWA -->\n    <link rel=\"manifest\" href=\"\/site.webmanifest\">\n\n    <title>Agence MGDA | Home<\/title>\n    \n    <!-- Section-specific CSS -->\n    <link rel=\"stylesheet\" href=\"http:\/\/localhost:8000\/assets\/css\/output.css\">\n        <\/head>\n<body>\n\n<header class=\"site-header\">\n    <div class=\"head-container transparent\">\n        <div class=\"logo\">\n            <a href=\"http:\/\/localhost:8000\">\n                <img src=\"http:\/\/localhost:8000\/assets\/images\/logoMGDA.png\" alt=\"Agence MGDA logo\">\n            <\/a>\n        <\/div>\n        \n        <!-- Burger menu -->\n        <div class=\"burger-menu\" id=\"burgerMenu\">\n            <span><\/span>\n            <span><\/span>\n            <span><\/span>\n        <\/div>\n\n        <!-- Navigation -->\n        <nav class=\"main-nav\" id=\"mainNav\">\n            <ul>\n                <li><a href=\"\/#home\">Accueil<\/a><\/li>\n                <li><a href=\"\/#about\">\u00c0 propos de nous<\/a><\/li>\n                <li><a href=\"\/#services\">Nos Services<\/a><\/li>\n                <li><a href=\"\/#portfolio\">Nos Maquettes<\/a><\/li>\n            <\/ul>\n            <a href=\"\/#contact\" class=\"btn-primary\"><span>Nous Contacter<\/span><\/a>\n        <\/nav>\n    <\/div>\n<\/header>\n\n<main class=\"home relative\">\n\n  <section id=\"home\" class=\"hero\">\n  <div class=\"hero-container\">\n\n    <!-- TEXTE PRINCIPAL -->\n    <div class=\"hero-left animate-slide-down\">\n      <h1>\n        \ud83c\udf3f Votre site.<br>\n        <span class=\"highlight\">Plus l\u00e9ger. Plus vert.<\/span>\n      <\/h1>\n\n      <h4 class=\"hero-subtitle\">\n        Un site \u00e9cologique, rapide et cl\u00e9 en main.<br>\n        Mettez votre entreprise en valeur\u2026 sans alourdir la plan\u00e8te.\n      <\/h4>\n\n      <div class=\"hero-buttons\">\n        <a href=\"#contact\" class=\"btn-secondary\"><span>C'est parti !<\/span><\/a>\n      <\/div>\n    <\/div>\n\n    <!-- Bulle informative -->\n    <div class=\"hero-right\">\n      <p class=\"stats\" id=\"hero-tip\">\n        81 % des clients comparent en ligne avant de choisir un prestataire.\n      <\/p>\n    <\/div>\n\n    \n\n<div class=\"hero-center\">\n\n  <!-- IMAGE MOBILE UNIQUEMENT -->\n  <div class=\"hero-mobile-image\">\n    <img \n      src=\"http:\/\/localhost:8000\/media\/pages\/home\/9fb63d0629-1765389326\/forge-700x-q60.webp\"\n      alt=\"\"\n      width=\"960\"\n      height=\"840\"\n      loading=\"lazy\"\n    >\n  <\/div>\n\n  <!-- SLIDER DESKTOP \/ TABLETTE -->\n  <div class=\"hero-slider\">\n          <picture>\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/9fb63d0629-1765389326\/forge-1200x-q60.webp\" \n          type=\"image\/webp\">\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/9fb63d0629-1765389326\/forge-1200x-q65.jpg\" \n          type=\"image\/jpeg\">\n\n        <img \n          src=\"http:\/\/localhost:8000\/media\/pages\/home\/9fb63d0629-1765389326\/forge-1200x-q65.webp\"\n          class=\"slide \"\n          alt=\"\"\n          width=\"960\"\n          height=\"840\"\n          loading=\"lazy\"        >\n      <\/picture>\n          <picture>\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/a71440e543-1765388391\/worker-1200x-q60.webp\" \n          type=\"image\/webp\">\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/a71440e543-1765388391\/worker-1200x-q65.jpg\" \n          type=\"image\/jpeg\">\n\n        <img \n          src=\"http:\/\/localhost:8000\/media\/pages\/home\/a71440e543-1765388391\/worker-1200x-q65.webp\"\n          class=\"slide \"\n          alt=\"\"\n          width=\"960\"\n          height=\"840\"\n          loading=\"lazy\"        >\n      <\/picture>\n          <picture>\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/1b381906a0-1765388391\/soudure-1200x-q60.webp\" \n          type=\"image\/webp\">\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/1b381906a0-1765388391\/soudure-1200x-q65.jpg\" \n          type=\"image\/jpeg\">\n\n        <img \n          src=\"http:\/\/localhost:8000\/media\/pages\/home\/1b381906a0-1765388391\/soudure-1200x-q65.webp\"\n          class=\"slide \"\n          alt=\"\"\n          width=\"960\"\n          height=\"840\"\n          loading=\"lazy\"        >\n      <\/picture>\n          <picture>\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/01bf0327d6-1765388391\/artist-1200x-q60.webp\" \n          type=\"image\/webp\">\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/01bf0327d6-1765388391\/artist-1200x-q65.jpg\" \n          type=\"image\/jpeg\">\n\n        <img \n          src=\"http:\/\/localhost:8000\/media\/pages\/home\/01bf0327d6-1765388391\/artist-1200x-q65.webp\"\n          class=\"slide \"\n          alt=\"\"\n          width=\"960\"\n          height=\"840\"\n          loading=\"lazy\"        >\n      <\/picture>\n          <picture>\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/be43bca290-1765388391\/commerc-1200x-q60.webp\" \n          type=\"image\/webp\">\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/be43bca290-1765388391\/commerc-1200x-q65.jpg\" \n          type=\"image\/jpeg\">\n\n        <img \n          src=\"http:\/\/localhost:8000\/media\/pages\/home\/be43bca290-1765388391\/commerc-1200x-q65.webp\"\n          class=\"slide \"\n          alt=\"\"\n          width=\"960\"\n          height=\"840\"\n          loading=\"lazy\"        >\n      <\/picture>\n          <picture>\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/986a5c8fd6-1765388391\/mecha-1200x-q60.webp\" \n          type=\"image\/webp\">\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/986a5c8fd6-1765388391\/mecha-1200x-q65.jpg\" \n          type=\"image\/jpeg\">\n\n        <img \n          src=\"http:\/\/localhost:8000\/media\/pages\/home\/986a5c8fd6-1765388391\/mecha-1200x-q65.webp\"\n          class=\"slide \"\n          alt=\"\"\n          width=\"960\"\n          height=\"840\"\n          loading=\"lazy\"        >\n      <\/picture>\n          <picture>\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/20bc184b64-1765388391\/pizza-1200x-q60.webp\" \n          type=\"image\/webp\">\n\n        <source \n          srcset=\"http:\/\/localhost:8000\/media\/pages\/home\/20bc184b64-1765388391\/pizza-1200x-q65.jpg\" \n          type=\"image\/jpeg\">\n\n        <img \n          src=\"http:\/\/localhost: