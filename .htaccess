# Kirby .htaccess

# Enable URL rewriting
RewriteEngine on
RewriteBase /

# Redirect to HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block directory listing
Options -Indexes

# Bloquer l'accès à l'ancienne URL du panel
RedirectMatch 403 ^/panel/

# Exclure favicon.ico et robots.txt des redirections vers index.php
RewriteCond %{REQUEST_URI} !^/favicon.ico$ [NC]

# All other requests go to Kirby's index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

<IfModule mod_expires.c>
  ExpiresActive On

  # Images
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS / JS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Manifest
  ExpiresByType application/manifest+json "access plus 1 year"

  # Vidéos (optionnel mais OK)
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Set-Cookie
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<FilesMatch "\.(js|css|png|jpg|jpeg|webp|avif|svg|ico)$">
  Header unset Set-Cookie
</FilesMatch>