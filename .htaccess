# Kirby .htaccess

# Enable URL rewriting
RewriteEngine on
RewriteBase /

# Redirect to HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block directory listing
Options -Indexes

# Bloquer l'accès à l'ancienne URL du panel
RedirectMatch 403 ^/panel/

# Exclure favicon.ico et robots.txt des redirections vers index.php
RewriteCond %{REQUEST_URI} !^/favicon.ico$ [NC]

# All other requests go to Kirby's index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

<IfModule mod_expires.c>
  ExpiresActive On

  # Images
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # CSS / JS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Manifest
  ExpiresByType application/manifest+json "access plus 1 year"

  # Vidéos (optionnel mais OK)
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Set-Cookie
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
    text/html \
    text/plain \
    text/css \
    text/javascript \
    application/javascript \
    application/x-javascript \
    application/json \
    application/manifest+json \
    image/svg+xml
</IfModule>

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Sécurité de base
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # Anti clickjacking (legacy + moderne)
  Header always set X-Frame-Options "SAMEORIGIN"

  # HSTS (HTTPS uniquement)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  # CSP minimaliste, compatible avec la plupart des sites Kirby
  # Note: 'unsafe-inline' sur style évite de casser si tu as des styles inline (sinon tu peux le retirer)
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests"
</IfModule>

<FilesMatch "\.(js|css|png|jpg|jpeg|webp|avif|svg|ico)$">
  Header unset Set-Cookie
</FilesMatch>

RedirectMatch 403 ^/(site|kirby|vendor)/
<FilesMatch "(^\.|composer\.(json|lock)$)">
  Require all denied
</FilesMatch>

<FilesMatch "\.(js|css|png|jpg|jpeg|webp|avif|svg|ico|woff2)$">
  Header always set Cache-Control "public, max-age=31536000, immutable"
  Header always unset Set-Cookie
</FilesMatch>